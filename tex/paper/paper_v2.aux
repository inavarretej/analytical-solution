\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Robustness of the CSS velocity profile under stochastic recurrence ($a = T = b = 1$; phase $\hat  {\tau } = 0.5$; 500 realisations at $c_v = 0.30$). Shaded bands show the 10th--90th percentile range; coloured lines are ensemble medians; the black dashed line is the deterministic CSS; vertical dashed lines mark $\hat  {x} = \pm 1$. \textbf  {(a)}~Only $T_j$ randomised. \textbf  {(b)}~Only $b_j$ randomised. \textbf  {(c)}~Both $T_j$ and $b_j$ randomised independently. \textbf  {(d)}~Plate-rate-conserving coupling $b_j = v_{\mathrm  {plate}}T_j$. In all four cases the ensemble median coincides with the deterministic CSS; see text for the physical interpretation of the band shapes.}}{16}{figure.15}\protected@file@percent }
\newlabel{fig:stochastic_css}{{15}{16}{Robustness of the CSS velocity profile under stochastic recurrence ($a = T = b = 1$; phase $\hat {\tau } = 0.5$; 500 realisations at $c_v = 0.30$). Shaded bands show the 10th--90th percentile range; coloured lines are ensemble medians; the black dashed line is the deterministic CSS; vertical dashed lines mark $\hat {x} = \pm 1$. \textbf {(a)}~Only $T_j$ randomised. \textbf {(b)}~Only $b_j$ randomised. \textbf {(c)}~Both $T_j$ and $b_j$ randomised independently. \textbf {(d)}~Plate-rate-conserving coupling $b_j = v_{\mathrm {plate}}T_j$. In all four cases the ensemble median coincides with the deterministic CSS; see text for the physical interpretation of the band shapes}{figure.15}{}}
