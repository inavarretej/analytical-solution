\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Rheological trade-off for Krafla (left, red) and Asal (right, blue), using the single-event step-response $\chi ^2$ landscape; the viscous-CSS best-fit $a$ (Sections~\ref {sec:krafla}, \ref {sec:asal}) is statistically indistinguishable ($<1\%$ different) at both sites, so the same iso-$a$ curve and uncertainty envelope apply. Each panel shows the iso-$a$ contour in the $(H,\,\eta )$ plane at the best-fit value. Dark shading propagates the 1$\sigma $ uncertainty on $a$ from the $\chi ^2$ fit at fixed $E = 40$~GPa; light shading additionally propagates $E$ over $[20,\,80]$~GPa (combined 1$\sigma $ envelope). The $H = 10$~km dashed line marks the reference elastic thickness; markers show published viscosity estimates (Krafla: open circle, \citealt  {sigmundsson1991postglacial}; open square, \citealt  {hofton1996post}; open circle with error bar, \citealt  {wright2012geophysical}; Asal: filled diamond, \citealt  {nooner2009post} for the Dabbahu segment of the same rift system; orange box, \citealt  {cattin2005numerical} — near-axis effective viscosity $\eta = 0.5$--$1\times 10^{18}$~Pa~s from a 2D thermo-mechanical FEM model of the first 6--8~yr post-rifting at Asal, with the seismogenic layer thickness $H = 3$--$12$~km from the same study). The Cattin et al.\ box lies well below the iso-$a^*$ curve, consistent with the local near-axis viscosity being lower than the laterally averaged bulk estimate from the 25-yr geodetic record.}}{14}{figure.13}\protected@file@percent }
\newlabel{fig:rheology_1sigma}{{13}{14}{Rheological trade-off for Krafla (left, red) and Asal (right, blue), using the single-event step-response $\chi ^2$ landscape; the viscous-CSS best-fit $a$ (Sections~\ref {sec:krafla}, \ref {sec:asal}) is statistically indistinguishable ($<1\%$ different) at both sites, so the same iso-$a$ curve and uncertainty envelope apply. Each panel shows the iso-$a$ contour in the $(H,\,\eta )$ plane at the best-fit value. Dark shading propagates the 1$\sigma $ uncertainty on $a$ from the $\chi ^2$ fit at fixed $E = 40$~GPa; light shading additionally propagates $E$ over $[20,\,80]$~GPa (combined 1$\sigma $ envelope). The $H = 10$~km dashed line marks the reference elastic thickness; markers show published viscosity estimates (Krafla: open circle, \citealt {sigmundsson1991postglacial}; open square, \citealt {hofton1996post}; open circle with error bar, \citealt {wright2012geophysical}; Asal: filled diamond, \citealt {nooner2009post} for the Dabbahu segment of the same rift system; orange box, \citealt {cattin2005numerical} — near-axis effective viscosity $\eta = 0.5$--$1\times 10^{18}$~Pa~s from a 2D thermo-mechanical FEM model of the first 6--8~yr post-rifting at Asal, with the seismogenic layer thickness $H = 3$--$12$~km from the same study). The Cattin et al.\^^Mbox lies well below the iso-$a^*$ curve, consistent with the local near-axis viscosity being lower than the laterally averaged bulk estimate from the 25-yr geodetic record}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces CSS deformation half-width $aT$ as a function of recurrence interval $T$ for Krafla (red, $a = 5.17\times 10^{-5}$~m~s$^{-1}$) and Asal (blue, $a = 9.47\times 10^{-6}$~m~s$^{-1}$). Vertical dashed lines mark estimated recurrence intervals; annotated points give the implied $aT$ values. Horizontal dash-dot lines mark the total span of each geodetic network used in this study: 230~km for Krafla (\citealt  {foulger1992post}, 1992; distance between outermost stations) and 17~km for Asal (Vigny et al., 2007; GPS profile extent). In both cases $aT$ substantially exceeds the network aperture, explaining why inter-rifting deformation has been interpreted as steady plate divergence rather than a broad visco-elastic transient.}}{14}{figure.14}\protected@file@percent }
\newlabel{fig:css_width}{{14}{14}{CSS deformation half-width $aT$ as a function of recurrence interval $T$ for Krafla (red, $a = 5.17\times 10^{-5}$~m~s$^{-1}$) and Asal (blue, $a = 9.47\times 10^{-6}$~m~s$^{-1}$). Vertical dashed lines mark estimated recurrence intervals; annotated points give the implied $aT$ values. Horizontal dash-dot lines mark the total span of each geodetic network used in this study: 230~km for Krafla (\citealt {foulger1992post}, 1992; distance between outermost stations) and 17~km for Asal (Vigny et al., 2007; GPS profile extent). In both cases $aT$ substantially exceeds the network aperture, explaining why inter-rifting deformation has been interpreted as steady plate divergence rather than a broad visco-elastic transient}{figure.14}{}}
