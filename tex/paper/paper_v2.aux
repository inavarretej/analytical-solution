\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Maxwell visco-elastic cumulative displacement. Displacement is normalised by $b$. Grey shading marks the elastic-rebound zone ($t$ below the shared-modulus-closure relaxation time of Equation~\ref {eq:tau_R_shared} at the Natron best-fit $a$). Cumulative displacement at $x = \ell _M$ for the viscous model (black) and two Maxwell cases ($\tau _R$ set to that closure value, orange; to five times it, dashed red). Orange shading marks the displacement deficit relative to viscous. Both Maxwell models converge to the common asymptote $b/2$ (dotted) after $t \gg \tau _R$.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:maxwell_displacement}{{6}{10}{Maxwell visco-elastic cumulative displacement. Displacement is normalised by $b$. Grey shading marks the elastic-rebound zone ($t$ below the shared-modulus-closure relaxation time of Equation~\ref {eq:tau_R_shared} at the Natron best-fit $a$). Cumulative displacement at $x = \ell _M$ for the viscous model (black) and two Maxwell cases ($\tau _R$ set to that closure value, orange; to five times it, dashed red). Orange shading marks the displacement deficit relative to viscous. Both Maxwell models converge to the common asymptote $b/2$ (dotted) after $t \gg \tau _R$}{figure.6}{}}
