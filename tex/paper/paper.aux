\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces One-parameter displacement fits to the Foulger et al.\ (1992) dataset (black dots with error bars). Green: CSS Step model ($a = 5.33\times 10^{-5}$~m~s$^{-1}$, $\chi ^2/\nu = 0.737$). Orange dashed: CSS Maxwell model ($a = 1.00\times 10^{-4}$~m~s$^{-1}$, $\chi ^2/\nu = 0.856$). Red: Foulger diffusion kernel ($\kappa = 0.473$, $\chi ^2/\nu = 0.981$).}}{10}{figure.1}\protected@file@percent }
\newlabel{fig:fits_1p}{{1}{10}{One-parameter displacement fits to the Foulger et al.\ (1992) dataset (black dots with error bars). Green: CSS Step model ($a = 5.33\times 10^{-5}$~m~s$^{-1}$, $\chi ^2/\nu = 0.737$). Orange dashed: CSS Maxwell model ($a = 1.00\times 10^{-4}$~m~s$^{-1}$, $\chi ^2/\nu = 0.856$). Red: Foulger diffusion kernel ($\kappa = 0.473$, $\chi ^2/\nu = 0.981$)}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces One-parameter velocity profiles. Colors as in Figure~\ref {fig:fits_1p}. The Foulger kernel (blue) predicts an unphysical velocity spike at the rift axis ($x = 0$), while both CSS models yield smooth, physically plausible profiles.}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:vel_1p}{{2}{11}{One-parameter velocity profiles. Colors as in Figure~\ref {fig:fits_1p}. The Foulger kernel (blue) predicts an unphysical velocity spike at the rift axis ($x = 0$), while both CSS models yield smooth, physically plausible profiles}{figure.2}{}}
