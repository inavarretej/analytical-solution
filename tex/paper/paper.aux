\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Joint EV and EVE RSS fits to both Krafla datasets, with $T$ derived from the fitted dike opening $b$ through the opening-rate relation $T=b/V$ at $V=1.8$~cm~yr$^{-1}$ and time measured from $t_0=1975$. (a) \citet  {foulger1992post} ($\tau _i=12$~yr, $\tau _f=15$~yr). (b) \citet  {hofton1996post} ($\tau _i=12$~yr, $\tau _f=17$~yr), plotted at its own uncorrected displacements, with the reference-frame offset absorbed into each curve rather than removed from the data. Curves: EV RSS (purple) and EVE RSS (navy), each with one $(a,b)$ shared by both panels; error bars are $1\sigma $. (c, d) Joint $\chi ^2$ landscapes in $(a,b)$ for the EV and EVE RSS, shown as $\Delta \chi ^2=\chi ^2-\chi ^2_{\min }$, with the reference-frame offset minimised at every grid point. Contours mark the 68.3, 95.4 and 99.7 per cent confidence levels for two parameters ($\Delta \chi ^2 = 2.30$, $6.17$, $11.83$); the cross marks the best fit. The right axis gives the derived $T=b/V$. See Table~\ref {tab:fits} for goodness-of-fit statistics.}}{14}{figure.10}\protected@file@percent }
\newlabel{fig:krafla_v_constrained}{{10}{14}{Joint EV and EVE RSS fits to both Krafla datasets, with $T$ derived from the fitted dike opening $b$ through the opening-rate relation $T=b/V$ at $V=1.8$~cm~yr$^{-1}$ and time measured from $t_0=1975$. (a) \citet {foulger1992post} ($\tau _i=12$~yr, $\tau _f=15$~yr). (b) \citet {hofton1996post} ($\tau _i=12$~yr, $\tau _f=17$~yr), plotted at its own uncorrected displacements, with the reference-frame offset absorbed into each curve rather than removed from the data. Curves: EV RSS (purple) and EVE RSS (navy), each with one $(a,b)$ shared by both panels; error bars are $1\sigma $. (c, d) Joint $\chi ^2$ landscapes in $(a,b)$ for the EV and EVE RSS, shown as $\Delta \chi ^2=\chi ^2-\chi ^2_{\min }$, with the reference-frame offset minimised at every grid point. Contours mark the 68.3, 95.4 and 99.7 per cent confidence levels for two parameters ($\Delta \chi ^2 = 2.30$, $6.17$, $11.83$); the cross marks the best fit. The right axis gives the derived $T=b/V$. See Table~\ref {tab:fits} for goodness-of-fit statistics}{figure.10}{}}
