\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Rheological trade-off for Krafla, for the EV RSS best-fit $a = 4.99\times 10^{-5}$~m~s$^{-1}$ (Section~\ref {sec:krafla}). The panel shows the iso-$a$ contour in the $(H,\,\eta )$ plane at the best-fit value. Dark shading propagates the 1$\sigma $ uncertainty on $a$ from the joint $\chi ^2$ landscape at fixed $E = 40$~GPa; light shading additionally propagates $E$ over $[20,\,80]$~GPa (combined 1$\sigma $ envelope). The $H = 10$~km dashed line marks the reference elastic thickness, and the filled circle with error bar the best fit at that thickness with its 1$\sigma $ range at $E=40$~GPa. Published estimates: dashed boxes, the channel-model viscosities of \citet  {foulger1992post} and \citet  {heki1993plate} for an elastic layer of 8--30~km (viscosities of a thin channel, not of a half-space, so not directly comparable); open square, \citet  {hofton1996post}; open circle with error bar, \citet  {wright2012geophysical}, drawn at $H=11$~km for legibility; open triangle, the upper bound $\eta \le 10^{19}$~Pa~s of \citet  {sigmundsson1991postglacial}.}}{17}{figure.12}\protected@file@percent }
\newlabel{fig:rheology_1sigma_krafla}{{12}{17}{Rheological trade-off for Krafla, for the EV RSS best-fit $a = 4.99\times 10^{-5}$~m~s$^{-1}$ (Section~\ref {sec:krafla}). The panel shows the iso-$a$ contour in the $(H,\,\eta )$ plane at the best-fit value. Dark shading propagates the 1$\sigma $ uncertainty on $a$ from the joint $\chi ^2$ landscape at fixed $E = 40$~GPa; light shading additionally propagates $E$ over $[20,\,80]$~GPa (combined 1$\sigma $ envelope). The $H = 10$~km dashed line marks the reference elastic thickness, and the filled circle with error bar the best fit at that thickness with its 1$\sigma $ range at $E=40$~GPa. Published estimates: dashed boxes, the channel-model viscosities of \citet {foulger1992post} and \citet {heki1993plate} for an elastic layer of 8--30~km (viscosities of a thin channel, not of a half-space, so not directly comparable); open square, \citet {hofton1996post}; open circle with error bar, \citet {wright2012geophysical}, drawn at $H=11$~km for legibility; open triangle, the upper bound $\eta \le 10^{19}$~Pa~s of \citet {sigmundsson1991postglacial}}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Rheological trade-off for Asal, for the EV RSS best-fit $a = 1.00\times 10^{-5}$~m~s$^{-1}$ (Section~\ref {sec:asal}). The panel shows the iso-$a$ contour in the $(H,\,\eta )$ plane at the best-fit value. Dark shading propagates the 1$\sigma $ uncertainty on $a$ from the joint $\chi ^2$ landscape at fixed $E = 40$~GPa; light shading additionally propagates $E$ over $[20,\,80]$~GPa (combined 1$\sigma $ envelope). The $H = 10$~km dashed line marks the reference elastic thickness; markers show published viscosity estimates: filled diamond, \citealt  {nooner2009post}, and star with error bar, \citealt  {wright2012geophysical}, both for the Dabbahu segment of the same rift system; orange box, \citealt  {cattin2005numerical} — near-axis effective viscosity $\eta = 0.5$--$1\times 10^{18}$~Pa~s from a 2D thermo-mechanical FEM model of the first 6--8~yr post-rifting at Asal, with the seismogenic layer thickness $H = 3$--$12$~km from the same study. The Cattin et al.\ box lies well below the iso-$a$ curve, consistent with the local near-axis viscosity being lower than the laterally averaged bulk estimate from the 25-yr geodetic record.}}{17}{figure.13}\protected@file@percent }
\newlabel{fig:rheology_1sigma_asal}{{13}{17}{Rheological trade-off for Asal, for the EV RSS best-fit $a = 1.00\times 10^{-5}$~m~s$^{-1}$ (Section~\ref {sec:asal}). The panel shows the iso-$a$ contour in the $(H,\,\eta )$ plane at the best-fit value. Dark shading propagates the 1$\sigma $ uncertainty on $a$ from the joint $\chi ^2$ landscape at fixed $E = 40$~GPa; light shading additionally propagates $E$ over $[20,\,80]$~GPa (combined 1$\sigma $ envelope). The $H = 10$~km dashed line marks the reference elastic thickness; markers show published viscosity estimates: filled diamond, \citealt {nooner2009post}, and star with error bar, \citealt {wright2012geophysical}, both for the Dabbahu segment of the same rift system; orange box, \citealt {cattin2005numerical} — near-axis effective viscosity $\eta = 0.5$--$1\times 10^{18}$~Pa~s from a 2D thermo-mechanical FEM model of the first 6--8~yr post-rifting at Asal, with the seismogenic layer thickness $H = 3$--$12$~km from the same study. The Cattin et al.\^^Mbox lies well below the iso-$a$ curve, consistent with the local near-axis viscosity being lower than the laterally averaged bulk estimate from the 25-yr geodetic record}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces RSS deformation half-width $aT$ as a function of recurrence interval $T$ for Krafla (red, $a = 4.99\times 10^{-5}$~m~s$^{-1}$) and Asal (blue, $a = 1.00\times 10^{-5}$~m~s$^{-1}$), the EV RSS best fits. Vertical dashed lines mark the recurrence intervals derived from $T=b/V$ (95~yr and 52~yr); stars give the implied $aT$. Horizontal dash-dot lines mark the total span of each geodetic network used in this study: 230~km for Krafla \citep  [distance between outermost stations;][]{foulger1992post} and 17~km for Asal \citep  [GPS profile extent;][]{vigny2007twenty}. The half-width $aT$ is comparable to the extent of each network on either side of the rift.}}{18}{figure.14}\protected@file@percent }
\newlabel{fig:css_width}{{14}{18}{RSS deformation half-width $aT$ as a function of recurrence interval $T$ for Krafla (red, $a = 4.99\times 10^{-5}$~m~s$^{-1}$) and Asal (blue, $a = 1.00\times 10^{-5}$~m~s$^{-1}$), the EV RSS best fits. Vertical dashed lines mark the recurrence intervals derived from $T=b/V$ (95~yr and 52~yr); stars give the implied $aT$. Horizontal dash-dot lines mark the total span of each geodetic network used in this study: 230~km for Krafla \citep [distance between outermost stations;][]{foulger1992post} and 17~km for Asal \citep [GPS profile extent;][]{vigny2007twenty}. The half-width $aT$ is comparable to the extent of each network on either side of the rift}{figure.14}{}}
