\newlabel{tab:fits}{{1}{12}{Best-fit parameters for each model and fitting strategy. Degrees of freedom: $\nu = 19$ (1p), $\nu = 18$ (2p), $\nu = 17$ (3p). The 1p fits fix $\omega = 1$~m}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Two- and three-parameter displacement fits against the Foulger et al.\ (1992) observations (black dots). Green: CSS Step 2p ($a = 4.79\times 10^{-5}$~m~s$^{-1}$, $\omega = 1.21$~m, $\chi ^2/\nu = 0.715$). Red: Foulger 2p ($\chi ^2/\nu = 0.902$). Orange: Maxwell 3p ($a = 6.69\times 10^{-5}$~m~s$^{-1}$, $\tau _R = 1.87$~yr, $\chi ^2/\nu = 0.776$). The annotations show $\chi ^2/\nu $ values for each model.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:fits_data}{{3}{12}{Two- and three-parameter displacement fits against the Foulger et al.\ (1992) observations (black dots). Green: CSS Step 2p ($a = 4.79\times 10^{-5}$~m~s$^{-1}$, $\omega = 1.21$~m, $\chi ^2/\nu = 0.715$). Red: Foulger 2p ($\chi ^2/\nu = 0.902$). Orange: Maxwell 3p ($a = 6.69\times 10^{-5}$~m~s$^{-1}$, $\tau _R = 1.87$~yr, $\chi ^2/\nu = 0.776$). The annotations show $\chi ^2/\nu $ values for each model}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Constraints on the Maxwell relaxation time}{12}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Profile likelihood for the Maxwell relaxation time $\tau _R$. Red dotted: best-fit ($\tau _R = 1.87$~yr). Grey dashed: 1$\sigma $ threshold ($\Delta \chi ^2 = 1$). Black dashed: 95\% confidence threshold ($\Delta \chi ^2 = 3.84$). Values $\tau _R > 5$~yr are excluded at 95\% confidence.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:tauR}{{4}{13}{Profile likelihood for the Maxwell relaxation time $\tau _R$. Red dotted: best-fit ($\tau _R = 1.87$~yr). Grey dashed: 1$\sigma $ threshold ($\Delta \chi ^2 = 1$). Black dashed: 95\% confidence threshold ($\Delta \chi ^2 = 3.84$). Values $\tau _R > 5$~yr are excluded at 95\% confidence}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Normalized step displacement $u/\omega $ vs.\ $\tau /\tau _R$ for the purely viscous (solid) and Maxwell (dashed) models at $x = 5$~km (blue), $x = 20$~km (orange), and $x = 100$~km (red). Both models converge at $\tau \gg \tau _R$.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:two_timescale}{{5}{14}{Normalized step displacement $u/\omega $ vs.\ $\tau /\tau _R$ for the purely viscous (solid) and Maxwell (dashed) models at $x = 5$~km (blue), $x = 20$~km (orange), and $x = 100$~km (red). Both models converge at $\tau \gg \tau _R$}{figure.5}{}}
